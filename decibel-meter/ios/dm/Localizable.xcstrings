    "permission_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access to measure sound. Audio stays on your device and is never saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리를 측정하려면 마이크 사용을 허용해주세요. 원음은 기기에서만 처리하며 저장하지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定するにはマイクへのアクセスを許可してください。音声は端末内だけで処理され、保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许麦克风访问以测量声音。音频仅在设备上处理，不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許麥克風存取以測量聲音。音訊僅在裝置上處理，不會儲存。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Mikrofonzugriff zur Schallmessung. Audio bleibt auf dem Gerät und wird nicht gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le micro pour mesurer le son. L’audio reste sur votre appareil et n’est jamais enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono para medir el sonido. El audio se procesa en tu dispositivo y nunca se guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone para medir o som. O áudio é processado no dispositivo e nunca é salvo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso al microfono per misurare il suono. L’audio resta sul dispositivo e non viene salvato."
          }
        }
      }
    },
