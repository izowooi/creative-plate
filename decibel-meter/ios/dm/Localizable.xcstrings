    "stable_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure a steady sound for at least 3 seconds. Avoid silence and clipping."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정한 소리를 3초 이상 측정하세요. 무음이나 입력 초과 상태에서는 보정할 수 없어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定した音を3秒以上測定してください。無音や入力クリッピングでは校正できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请测量至少3秒稳定的声音，避免静音或输入削波。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請測量至少3秒穩定的聲音，避免靜音或輸入削波。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 3 Sekunden gleichmäßigen Schall messen. Stille und Übersteuerung vermeiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez un son stable pendant au moins 3 secondes, sans silence ni saturation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide un sonido estable durante al menos 3 segundos. Evita el silencio y la saturación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça um som estável por pelo menos 3 segundos. Evite silêncio e saturação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura un suono stabile per almeno 3 secondi. Evita silenzio e saturazione."
          }
        }
      }
    },
