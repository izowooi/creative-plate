            "state": "translated",
            "value": "Only numeric levels and input settings are included. Audio is never recorded."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수치와 입력 설정만 포함합니다. 원음은 녹음하지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値と入力設定のみを含みます。音声は録音しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含数值和输入设置，不录制音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅包含數值和輸入設定，不錄製音訊。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält nur Pegelwerte und Eingangseinstellungen. Audio wird nie aufgezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les niveaux et réglages d’entrée sont inclus. Aucun son n’est enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo incluye niveles numéricos y ajustes de entrada. Nunca se graba audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui apenas níveis numéricos e configurações de entrada. O áudio nunca é gravado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include solo livelli numerici e impostazioni di ingresso. L’audio non viene registrato."
          }
        }
      }
    },
