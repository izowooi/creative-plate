    "reference_unit_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference must use the same A / Flat weighting. One-point calibration does not correct the full frequency response."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준 계측기의 A / 무가중 설정이 같아야 합니다. 한 지점 보정은 전체 주파수 응답을 교정하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準騒音計のA特性／重み付けなし設定を合わせてください。一点校正では周波数応答全体を補正できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考仪器必须使用相同的A计权或无计权。单点校准不能校正完整频率响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考儀器必須使用相同的A加權或無加權。單點校準不能校正完整頻率響應。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Referenzgerät muss dieselbe A-Bewertung bzw. unbewertete Einstellung verwenden. Eine Einpunktkalibrierung korrigiert nicht den gesamten Frequenzgang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sonomètre de référence doit utiliser la même pondération A ou aucune pondération. Un étalonnage en un point ne corrige pas toute la réponse fréquentielle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La referencia debe usar la misma ponderación A o sin ponderar. La calibración de un punto no corrige toda la respuesta frecuencial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A referência deve usar a mesma ponderação A ou sem ponderação. A calibração de um ponto não corrige toda a resposta de frequência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riferimento deve usare la stessa ponderazione A o nessuna ponderazione. La calibrazione a un punto non corregge l’intera risposta in frequenza."
          }
        }
      }
    },
