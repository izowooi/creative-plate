    "microphone_usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sori uses the microphone to measure sound levels on your device. Audio is never saved or sent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리결이 기기에서 소리 레벨을 측정하기 위해 마이크를 사용합니다. 원음은 저장하거나 전송하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Soriは端末内で音レベルを測定するためにマイクを使用します。音声は保存・送信しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sori使用麦克风在设备上测量声音电平。音频不会被保存或发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sori使用麥克風在裝置上測量聲音位準。音訊不會被儲存或傳送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sori verwendet das Mikrofon, um Schallpegel auf Ihrem Gerät zu messen. Audio wird nie gespeichert oder gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sori utilise le micro pour mesurer le niveau sonore sur votre appareil. L’audio n’est jamais enregistré ni envoyé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sori usa el micrófono para medir el sonido en tu dispositivo. El audio nunca se guarda ni se envía."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sori usa o microfone para medir o som no dispositivo. O áudio nunca é salvo ou enviado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sori usa il microfono per misurare il suono sul dispositivo. L’audio non viene salvato né inviato."
          }
        }
      }
