    "privacy_explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound is processed on your device. Microphone audio is never saved or uploaded, and measurements are never automatically uploaded. Calibration profiles and your last session stay on this device. Sharing a CSV sends only the file you choose through the app you select."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 기기 안에서 처리합니다. 마이크 원음과 측정 결과를 저장 서버로 전송하지 않아요. 보정 프로필과 마지막 측정은 이 기기에 남습니다. CSV 공유 시 선택한 앱으로 선택한 파일만 전달합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音は端末内で処理されます。Soriはマイクの音声や測定結果をサーバーへ送信しません。校正プロファイルと直近の測定は端末内に保存されます。CSV共有では選んだファイルだけを選択したアプリへ渡します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音在设备上处理。Sori不会保存麦克风原音，也不会上传原音或测量结果。校准配置和上次测量保留在本设备上。分享CSV时，仅通过所选应用传递所选文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聲音在裝置上處理。Sori不會儲存麥克風原音，也不會上傳原音或測量結果。校準設定檔和上次測量保留在本裝置上。分享CSV時，僅透過所選應用程式傳遞所選檔案。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schall wird auf Ihrem Gerät verarbeitet. Sori speichert kein Mikrofon-Audio und lädt weder Audio noch Messwerte hoch. Kalibrierprofile und die letzte Messung bleiben auf diesem Gerät. Beim CSV-Teilen wird nur die gewählte Datei an die ausgewählte App übergeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son est traité sur votre appareil. Sori n’enregistre jamais l’audio du micro et n’envoie ni audio ni mesures à un serveur. Les profils et la dernière session restent sur cet appareil. Le partage CSV transmet uniquement le fichier choisi à l’app sélectionnée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido se procesa en tu dispositivo. Sori nunca guarda el audio del micrófono ni sube audio o mediciones. Los perfiles y la última sesión permanecen en este dispositivo. Al compartir un CSV, solo se envía el archivo elegido a la aplicación seleccionada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som é processado no dispositivo. O Sori nunca salva o áudio do microfone nem envia áudio ou medições a um servidor. Os perfis e a última sessão ficam neste dispositivo. Ao compartilhar CSV, apenas o arquivo escolhido é enviado pelo app selecionado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suono viene elaborato sul dispositivo. Sori non salva l’audio del microfono e non carica audio o misurazioni su un server. I profili e l’ultima sessione restano sul dispositivo. Condividendo un CSV, solo il file scelto viene passato all’app selezionata."
          }
        }
      }
    },
