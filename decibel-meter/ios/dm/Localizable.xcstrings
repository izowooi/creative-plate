    "error_microphone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone could not start. Close other recording apps and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 시작할 수 없어요. 다른 녹음 앱을 종료한 뒤 다시 시도해주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを開始できません。他の録音アプリを閉じて、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动麦克风。请关闭其他录音应用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動麥克風。請關閉其他錄音應用程式後重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht gestartet werden. Andere Aufnahme-Apps schließen und erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le micro. Fermez les autres apps d’enregistrement et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el micrófono. Cierra otras apps de grabación y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o microfone. Feche outros apps de gravação e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il microfono. Chiudi le altre app di registrazione e riprova."
          }
        }
      }
    },
    "interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurement stopped because another app or a call used the microphone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이나 통화가 마이크를 사용해 측정을 종료했어요."
