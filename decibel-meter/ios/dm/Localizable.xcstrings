    "diagnostics_explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Firebase Crashlytics receives crash reports, app/device information and an installation identifier to help fix problems. Audio and sound levels are never included. You can turn this off at any time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항입니다. 오류 개선을 위해 Firebase Crashlytics에 오류 보고서, 앱·기기 정보와 설치 식별자를 전송합니다. 원음과 측정값은 포함하지 않으며 언제든 끌 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。問題改善のため、Firebase Crashlyticsへクラッシュ報告、アプリ・端末情報、インストール識別子を送ります。音声や測定値は含みません。いつでも無効にできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。Firebase Crashlytics会接收崩溃报告、应用及设备信息和安装标识符，用于修复问题。不包含音频或测量值，可随时关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選用。Firebase Crashlytics會接收當機報告、應用程式與裝置資訊及安裝識別碼，用於修復問題。不包含音訊或測量值，可隨時關閉。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Firebase Crashlytics erhält Absturzberichte, App- und Geräteinformationen sowie eine Installationskennung zur Fehlerbehebung. Audio und Schallpegel werden nie übermittelt. Jederzeit abschaltbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Firebase Crashlytics reçoit les rapports de plantage, des informations sur l’app et l’appareil, ainsi qu’un identifiant d’installation pour corriger les problèmes. Aucun audio ni niveau sonore n’est inclus. Désactivable à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Firebase Crashlytics recibe informes de fallos, información de la app y del dispositivo y un identificador de instalación para corregir problemas. Nunca incluye audio ni niveles sonoros. Puedes desactivarlo cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. O Firebase Crashlytics recebe relatórios de falhas, informações do app e do dispositivo e um identificador de instalação para corrigir problemas. Áudio e níveis sonoros nunca são incluídos. Você pode desativar a qualquer momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Firebase Crashlytics riceve rapporti sugli arresti, informazioni su app e dispositivo e un identificativo di installazione per correggere i problemi. Audio e livelli sonori non sono mai inclusi. Puoi disattivarlo in qualsiasi momento."
          }
        }
      }
    },
