            "value": "실제 음압(dB SPL)이 아닌 입력 레벨이에요. 기준 소음계로 보정할 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の音圧ではなく入力レベルです。基準騒音計で校正できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是输入电平，不是实际声压。可使用参考声级计校准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是輸入位準，不是實際聲壓。可使用參考聲級計校準。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitaler Eingangspegel, kein Schalldruck. Mit einem Referenzgerät kalibrieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau d’entrée numérique, pas une pression acoustique. Étalonnez avec un sonomètre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada digital, no presión sonora. Calibra con un sonómetro de referencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada digital, não pressão sonora. Calibre com um sonômetro de referência."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresso digitale, non pressione sonora. Calibra con un fonometro di riferimento."
          }
        }
      }
    },
    "estimated_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-point estimate. Accuracy varies by device and sound."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 지점 보정 추정치예요. 기기와 소리에 따라 오차가 있어요."
          }
        },
        "ja": {
