    "calibration_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a reference sound level meter beside your phone. Match its frequency weighting, keep the sound steady, and enter its reading. Saving ends this session; the profile applies to the next measurement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 옆에 기준 소음계를 놓으세요. 가중 방식을 맞추고 소리가 일정할 때 기준값을 입력하세요. 저장하면 이번 측정이 끝나고 다음 측정부터 적용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準騒音計を端末の横に置き、周波数重み付けを合わせてください。音が安定したら基準値を入力します。保存すると測定が終了し、次回から適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将参考声级计放在手机旁，设置相同的频率计权。声音稳定后输入参考读数。保存将结束本次测量，并从下次测量开始应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將參考聲級計放在手機旁，設定相同的頻率加權。聲音穩定後輸入參考讀數。儲存會結束本次測量，並從下次測量開始套用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie ein Referenzmessgerät neben das Telefon und wählen Sie dieselbe Frequenzbewertung. Geben Sie bei gleichmäßigem Schall den Referenzwert ein. Speichern beendet diese Messung; das Profil gilt ab der nächsten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un sonomètre de référence près du téléphone et choisissez la même pondération. Saisissez sa valeur quand le son est stable. L’enregistrement termine cette mesure ; le profil s’applique à la suivante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un sonómetro de referencia junto al teléfono y usa la misma ponderación. Introduce su lectura cuando el sonido sea estable. Guardar termina esta sesión; el perfil se aplica a la siguiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um sonômetro de referência ao lado do celular e use a mesma ponderação. Insira a leitura quando o som estiver estável. Salvar encerra esta sessão; o perfil vale para a próxima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona un fonometro di riferimento accanto al telefono e usa la stessa ponderazione. Inserisci la lettura quando il suono è stabile. Salvando termini la sessione; il profilo vale dalla successiva."
          }
        }
      }
    },
    "profiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration profiles"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보정 프로필"
          }
        },
        "ja": {
