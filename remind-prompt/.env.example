# Slack Incoming Webhook URL. Keep the real value outside Git.
REMIND_PROMPT_SLACK_WEBHOOK_URL=

# Local defaults
REMIND_PROMPT_DATABASE_PATH=./data/remind-prompt.db
REMIND_PROMPT_TIMEZONE=Asia/Seoul
REMIND_PROMPT_BASE_URL=http://127.0.0.1:8765
REMIND_PROMPT_HOST=127.0.0.1
REMIND_PROMPT_PORT=8765

# Worker behavior
REMIND_PROMPT_POLL_INTERVAL_SECONDS=30
REMIND_PROMPT_FOLLOW_UP_HOURS=24
REMIND_PROMPT_SLACK_PROMPT_MAX_CHARS=1200
