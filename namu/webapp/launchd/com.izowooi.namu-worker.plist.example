<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  집 수집 워커를 로그인할 때 자동으로 띄우고, 죽으면 다시 살리는 launchd 예시. 설치는 선택 사항이다.
  (Mac 이 잠자기 중이면 워커도 멈추고, 깨어나면 밀린 작업을 이어서 처리한다.)

  설치:   cp com.izowooi.namu-worker.plist.example ~/Library/LaunchAgents/com.izowooi.namu-worker.plist
          launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.izowooi.namu-worker.plist
  상태:   launchctl print gui/$(id -u)/com.izowooi.namu-worker | head
  중지:   launchctl bootout gui/$(id -u)/com.izowooi.namu-worker
  로그:   ~/Library/Logs/namu-worker.log

  python3 경로와 WorkingDirectory 는 이 컴퓨터 기준이다. 다른 컴퓨터에서는 맞게 고쳐 쓴다.
  토큰과 DB 주소는 ~/.config/namu/ 의 token, worker.env 에서 읽으므로 이 파일에는 비밀이 없다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.izowooi.namu-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/izowooi/anaconda3/bin/python3</string>
    <string>-m</string>
    <string>namu_crawler.worker</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/izowooi/git/creative-plate/namu/webapp</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/izowooi/Library/Logs/namu-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/izowooi/Library/Logs/namu-worker.log</string>
</dict>
</plist>
